{
  "schemaVersion": 1,
  "id": "more-doors-justfatlard",
  "version": "${version}",
  "name": "Moredoor",
  "description": "Doors with depth, doors that lock, doors that swing together, and six variants of every door (four of every trapdoor) for every material",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/moredoor"
  },
  "license": "MIT",
  "icon": "assets/more-doors-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.moredoor.Main"
    ]
  },
  "mixins": [
    "moredoor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=1.3.9"
  }
}
